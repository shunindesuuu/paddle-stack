{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"],
    "outDir": ".verify",
    "ignoreDeprecations": "6.0"
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts"],
  "exclude": ["src/db/client.ts"]
}
